# Copy to synapsefly.env on the VPS and fill in. NEVER commit the real file.
# --- simulation ---
FLY_N_NEURONS=20000
FLY_SEED=1337
FLY_REALTIME=1
FLY_CONNECTOME_SOURCE=synthetic
# --- market: simulated until the $SYNAPSE pair lists ---
# With FLY_MARKET=sim the page shows a simulated feed and labels it as such.
# To go live: FLY_MARKET=dexscreener + the pair address and its chain below.
FLY_MARKET=sim
# set the $SYNAPSE pair address once it lists; leave blank to keep FLY_MARKET=sim
FLY_TOKEN_ADDRESS=
FLY_CHAIN=
# --- LLM tweet generation (keep dryrun until you add a key) ---
FLY_LLM=dryrun
# FLY_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
FLY_LLM_MODEL=claude-opus-5
# --- X / Twitter posting (keep dryrun until you add OAuth1 keys) ---
# These four names are the ones the agent actually reads (flybrain/agent/x_client.py CRED_KEYS);
# the X developer portal calls the first two "API key" / "API key secret" (a.k.a. consumer key/secret).
FLY_X=dryrun
# FLY_X=post
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# --- server / web ---
FLY_HOST=0.0.0.0
FLY_PORT=4000
FLY_CORS_ORIGINS=https://synapsefly.com,https://www.synapsefly.com
# /api/health is public on api.synapsefly.com: keep the recent-log tail out of it.
FLY_HEALTH_LOG_TAIL=0
