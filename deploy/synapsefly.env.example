# Copy to synapsefly.env on the VPS and fill in. NEVER commit the real file.
# --- simulation ---
FLY_N_NEURONS=20000
FLY_SEED=1337
FLY_REALTIME=1
FLY_CONNECTOME_SOURCE=synthetic
# --- market: live DexScreener (CASHCAT on the robinhood chain, per your CA) ---
FLY_MARKET=dexscreener
FLY_TOKEN_ADDRESS=0x020bfc650a365f8bb26819deaabf3e21291018b4
FLY_CHAIN=robinhood
# --- LLM tweet generation (keep dryrun until you add a key) ---
FLY_LLM=dryrun
# FLY_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
FLY_LLM_MODEL=claude-opus-5
# --- X / Twitter posting (keep dryrun until you add OAuth1 keys) ---
FLY_X=dryrun
# FLY_X=post
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# --- server / web ---
FLY_HOST=0.0.0.0
FLY_PORT=4000
FLY_CORS_ORIGINS=https://synapsefly.com,https://www.synapsefly.com
