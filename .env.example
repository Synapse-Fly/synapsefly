# ---- SynapseFly / FlyBrain ----  (all defaults run offline with zero accounts)
#
# Copy this file to .env (PowerShell: Copy-Item .env.example .env) and edit what you need.
# Every value below IS the section-b default, so an unedited copy behaves exactly like no .env at all.
# Comments must stay on their own line: the parser (flybrain.config.parse_dotenv) takes everything
# after the first '=' as the value, so "FLY_TICK_HZ=20   # ticks" would be read as "20   # ticks".
# A blank value means "use the built-in default". Frontend variables live in frontend/.env.local.

# ---------------------------------------------------------------------------- connectome
# synthetic | csv | neuprint -- where the graph comes from (synthetic needs no download)
FLY_CONNECTOME_SOURCE=synthetic
# for csv: the directory holding neurons.csv(.gz) + connections.csv(.gz) (neuPrint or Codex schema)
FLY_CONNECTOME_DIR=data/connectome/malecns
# display name override shown in the UI and /api/health (blank = derived from the source)
FLY_CONNECTOME_NAME=
# neuron count 4000..200000 (8000 on a weak laptop, 20000 is the default brain)
FLY_N_NEURONS=20000
# mean out-degree of the synthetic graph's background connectivity, 5..200
FLY_MEAN_OUTDEG=25
# calibrated | literature -- synthetic weights; calibrated fires the pathways at gain 1.0
FLY_SYNTH_WEIGHTS=calibrated
# real data only: core (functional cells + random fill) | all (the whole graph, memmapped)
FLY_SUBSET=core
# drop edges below this synapse count when loading real data (>= 1)
FLY_MIN_WEIGHT=3

# ---------------------------------------------------------------------------- engine
# integration step in ms: 1.0 | 0.5 | 0.2 | 0.1 (smaller = finer and slower)
FLY_DT_MS=1.0
# master seed; every stream is a SeedSequence child of it, so the whole run is reproducible
FLY_SEED=1337
# numpy | torch | auto -- spike propagation backend (auto picks torch above 5M edges)
FLY_BACKEND=numpy
# auto | float -- synaptic gain; auto = 1.0 for calibrated synthetic, else the cached calibration
FLY_GAIN=auto
# background noise mean current per ms (mV); 0 with sigma 0 gives a silent brain
FLY_NOISE_MU=0.5
# background noise std per sqrt(ms) (mV); 3.5 gives the 1-5 Hz resting rate
FLY_NOISE_SIGMA=3.5
# poisson | current -- how sensory drives enter the brain (poisson = spike trains)
FLY_DRIVE_MODE=poisson
# wall ticks per second of the simulation loop, 5..50 (20 = one tick per 50 ms)
FLY_TICK_HZ=20
# 1 = pace the sim to the wall clock; 0 = run as fast as the CPU allows (tests, scripts)
FLY_REALTIME=1

# ---------------------------------------------------------------------------- market
# sim | dexscreener -- the token feed; sim needs no network
FLY_MARKET=sim
# the pair/mint address to track; required for dexscreener, ignored by sim
FLY_TOKEN_ADDRESS=
# chain slug used by the DexScreener lookup (solana, ethereum, base, ...)
FLY_CHAIN=solana
# 0 = the tracked pair is a STAND-IN sensory feed and this project's token has NOT launched; the UI, the API and
# the tweet agent all say so. Keep it 0 until FLY_TOKEN_ADDRESS is this project's own real pair address; only
# then set it to 1, or every surface will present somebody else's price and market cap as this project's own.
FLY_TOKEN_LIVE=0
# seconds between DexScreener polls, 15..86400 (their edge cache is 60 s)
FLY_DEX_POLL_S=60
# mean seconds the simulated market stays in one regime before switching
FLY_SIM_REGIME_S=90

# ---------------------------------------------------------------------------- agent (LLM)
# dryrun | anthropic -- dryrun writes template tweets and never calls the API
FLY_LLM=dryrun
# Anthropic key; only read when FLY_LLM=anthropic (never stored in Settings, never served by /api/config)
ANTHROPIC_API_KEY=
# model id used for tweet generation
FLY_LLM_MODEL=claude-opus-5
# 1 = ask the model for structured JSON output, 0 = accept plain text
FLY_LLM_JSON=1
# 1 = allow falling back to other model ids when the configured one is unavailable
FLY_LLM_FALLBACKS=0
# en | tr -- tweet language
FLY_TWEET_LANG=en

# ---------------------------------------------------------------------------- agent (X)
# dryrun | post -- dryrun writes out/tweets/<id>.* and posts nothing
FLY_X=dryrun
# X / Twitter OAuth1 consumer key; only read when FLY_X=post (app must be Read+Write)
X_API_KEY=
# X / Twitter OAuth1 consumer secret
X_API_SECRET=
# X / Twitter OAuth1 user access token (regenerate it after enabling write access)
X_ACCESS_TOKEN=
# X / Twitter OAuth1 user access token secret
X_ACCESS_TOKEN_SECRET=
# minimum seconds between any two tweets
FLY_TWEET_COOLDOWN_S=900
# minimum seconds between two tweets with the same trigger reason
FLY_TWEET_REASON_COOLDOWN_S=2700
# hard cap on tweets per UTC day (0 disables tweeting entirely)
FLY_TWEETS_PER_DAY=12

# ---------------------------------------------------------------------------- server / body
# backend port 1..65535
FLY_PORT=4000
# bind address; 127.0.0.1 keeps the server off the network
FLY_HOST=127.0.0.1
# comma-separated list of allowed browser origins
FLY_CORS_ORIGINS=http://localhost:3000
# Paint canvas width in px, 64..8000 (must match the frontend canvas)
FLY_CANVAS_W=800
# Paint canvas height in px, 64..8000
FLY_CANVAS_H=500
# bounce | wrap -- what the fly does at the canvas edge
FLY_WALLS=bounce
# raster rows sampled per region, 8..128
FLY_RASTER_PER_REGION=48
# maximum raster events sent per tick (the rest are subsampled)
FLY_RASTER_CAP=2000
# 1 = let the mood drive feedback currents back into the brain (puppeteering; 0 disables)
FLY_MOOD_FEEDBACK=1
# exploration drive floor 0..1 (0 = pure connectome-driven walking, the fly may stall)
FLY_EXPLORE_BASELINE=0.25
# angular-velocity wander noise (rad/s per sqrt(s)); 0 = no wander
FLY_WANDER_SIGMA=0.6
# 1 = enable the 420 / buys_m5 easter eggs
FLY_EASTER_EGGS=1
# 1 = write data/sessions/<run_id>.jsonl (needed by scripts/replay.py)
FLY_SESSION_LOG=1
# path to a session log to replay instead of running live (blank = live)
FLY_REPLAY=
# data directory (cache, sessions, snapshots, agent state); blank = <repo>/data
FLY_DATA_DIR=
# output directory (logs, tweet artifacts); blank = <repo>/out
FLY_OUT_DIR=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FLY_LOG_LEVEL=INFO
# include the recent-log tail in GET /api/health; set 0 when the API is reachable from the internet
FLY_HEALTH_LOG_TAIL=1

# ---------------------------------------------------------------------------- data scripts only
# neuPrint token for scripts/fetch_neuprint.py (anonymous access works without it)
NEUPRINT_APPLICATION_CREDENTIALS=
